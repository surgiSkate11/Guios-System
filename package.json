{
  "name": "guios-pro",
  "version": "0.1.0",
  "private": true,
  "description": "GUIOS PRO: web application to evaluate candidate software against an organization's requirements.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
